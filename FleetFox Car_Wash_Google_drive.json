            "Assessment": "={{ $('Parse Analysis Results').item.json.overallAssessment }}",
            "Issues Count": "={{ $('Parse Analysis Results').item.json.issues.length }}",
            "Issue Types": "={{ $('Parse Analysis Results').item.json.issues.map(i => i.type).join(', ') }}",
            "Severities": "={{ $('Parse Analysis Results').item.json.issues.map(i => i.severity).join(', ') }}",
            "Feedback Sent": "={{ $('Generate Contractor Feedback').item.json.message ? 'Yes' : 'No' }}"
          }
        },
        "options": {}
