      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        180,
        -360
      ],
      "id": "0365bf5f-91ff-4b05-be08-cc4af8a5fa3a",
      "name": "Download Image"
    },
    {
      "parameters": {
        "resource": "image",
        "operation": "analyze",
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o"
        },
        "text": "You are a professional car wash quality inspector. Analyze this car wash image and provide a detailed JSON response with the following structure:\n{\n  \"qualityScore\": (0-100),\n  \"overallAssessment\": \"pass\" or \"fail\",\n  \"issues\": [\n    {\n      \"type\": \"water_spots|poor_lighting|dirt|soap_residue|missed_areas|scratches|other\",\n      \"severity\": \"low|medium|high\",\n      \"location\": \"specific area of the car\",\n      \"description\": \"detailed description of the issue\"\n    }\n  ],\n  \"recommendations\": [\"specific actionable steps to fix issues\"]\n}\n\nBe thorough and specific. A score below 80 should be marked as 'fail'.",
        "inputType": "binaryData",
        "options": {
          "detail": "high",
          "maxTokens": 1500
        }
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.6,
      "position": [
        400,
        -360
      ],
      "id": "6b1af0db-c0b6-4062-b466-474f0d167202",
      "name": "Analyze Car Wash Quality",
      "credentials": {
        "openAiApi": {
          "id": "7Qo85TfYOyT5i3MU",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse the OpenAI analysis response\nconst aiResponse = $input.item.json.message;\nlet analysisResult;\n\ntry {\n  // Extract JSON from the response\n  const jsonMatch = aiResponse.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    analysisResult = JSON.parse(jsonMatch[0]);\n  } else {\n    throw new Error(\"No JSON found in response\");\n  }\n} catch (error) {\n  // Fallback if parsing fails\n  analysisResult = {\n    qualityScore: 0,\n    overallAssessment: \"fail\",\n    issues: [{\n      type: \"parsing_error\",\n      severity: \"high\",\n      location: \"system\",\n      description: \"Failed to parse AI response: \" + error.message\n    }],\n    recommendations: [\"Please retry the inspection\"]\n  };\n}\n\n// Add metadata from the file\nanalysisResult.timestamp = new Date().toISOString();\nanalysisResult.fileName = $('Google Drive Trigger - New Car Wash Photo').item.json.name;\nanalysisResult.fileId = $('Google Drive Trigger - New Car Wash Photo').item.json.id;\nanalysisResult.contractorId = extractContractorFromFileName(analysisResult.fileName);\nanalysisResult.inspectionId = generateInspectionId();\n\n// Helper functions\nfunction extractContractorFromFileName(fileName) {\n  // Extract contractor ID from filename\n  // Example: \"contractor123_location_date.jpg\" -> \"contractor123\"\n  const match = fileName.match(/^([^_]+)_/);\n  return match ? match[1] : 'unknown';\n}\n\nfunction generateInspectionId() {\n  return 'INS-' + Date.now() + '-' + Math.random().toString(36).substr(2, 9);\n}\n\nreturn {\n  json: analysisResult\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        -440
      ],
      "id": "b2330111-d855-4938-bdd2-cf2350b7e102",
      "name": "Parse Analysis Results"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.overallAssessment }}",
                    "rightValue": "fail",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "id": "2cc9c0e1-cda6-42c1-839d-237c46d67ca6"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Failed Quality Check"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        800,
        -240
      ],
      "id": "53fef2c9-f716-415d-a855-befb6020227c",
      "name": "Quality Check Router",
      "outputNames": [
        "Passed Quality Check"
      ]
    },
    {
      "parameters": {
        "resource": "chat"
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.6,
