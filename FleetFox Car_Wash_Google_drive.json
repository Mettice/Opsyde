        940,
        -560
      ],
      "id": "f7b72b52-e5d5-4cb6-a5b6-2cae7a6da5d0",
      "name": "Generate Contractor Feedback",
      "credentials": {
        "openAiApi": {
          "id": "7Qo85TfYOyT5i3MU",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "messageType": "block",
        "blocksUi": {
          "blocksValues": [
            {
              "type": "header",
              "text": {
                "type": "plain_text",
                "text": "⚠️ Car Wash Quality Alert"
              }
            },
            {
              "type": "section",
              "text": {
                "type": "mrkdwn",
                "text": "*Inspection ID:* {{ $('Parse Analysis Results').item.json.inspectionId }}\\n*Quality Score:* {{ $('Parse Analysis Results').item.json.qualityScore }}/100\\n*Status:* ❌ FAILED\\n*Contractor:* {{ $('Parse Analysis Results').item.json.contractorId }}\\n*File:* {{ $('Parse Analysis Results').item.json.fileName }}"
              }
            },
            {
              "type": "divider"
            },
            {
              "type": "section",
              "text": {
                "type": "mrkdwn",
                "text": "*Issues Found:*\\n{{ $('Parse Analysis Results').item.json.issues.map((i, idx) => `${idx + 1}. *${i.type.replace('_', ' ')}* (${i.severity}): ${i.description} - _${i.location}_`).join('\\n') }}"
              }
            },
            {
              "type": "section",
              "text": {
                "type": "mrkdwn",
                "text": "*Contractor Message:*\\n```{{ $json.message }}```"
              }
            }
          ]
        },
        "otherOptions": {}
      },
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        1300,
        -680
