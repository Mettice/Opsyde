      "id": "85c50ab8-14b0-4471-928a-25a3d691e032",
      "name": "Notify Slack - Failed",
      "webhookId": "ab38f37c-6412-479b-a205-cf268801a0d4"
    },
    {
      "parameters": {
        "sendTo": "={{ $('Parse Analysis Results').item.json.contractorId }}@yourcompany.com",
        "subject": "🚨 Car Wash Quality Inspection Failed - Immediate Action Required",
        "message": "<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n  <div style=\"background-color: #ff4444; color: white; padding: 20px; text-align: center;\">\n    <h1 style=\"margin: 0;\">Quality Inspection Failed</h1>\n  </div>\n  \n  <div style=\"padding: 20px; background-color: #f5f5f5;\">\n    <p><strong>Inspection ID:</strong> {{ $('Parse Analysis Results').item.json.inspectionId }}</p>\n    <p><strong>Date:</strong> {{ $('Parse Analysis Results').item.json.timestamp }}</p>\n    <p><strong>Quality Score:</strong> <span style=\"color: #ff4444; font-size: 24px; font-weight: bold;\">{{ $('Parse Analysis Results').item.json.qualityScore }}/100</span></p>\n    \n    <h2 style=\"color: #333;\">Issues Found:</h2>\n    <ul style=\"background-color: white; padding: 20px; border-radius: 5px;\">\n      {{ $('Parse Analysis Results').item.json.issues.map(i => `<li><strong>${i.type.replace('_', ' ')}:</strong> ${i.description} (${i.location}) - <span style=\"color: ${i.severity === 'high' ? '#ff4444' : i.severity === 'medium' ? '#ff9944' : '#ffcc44'}\">${i.severity.toUpperCase()}</span></li>`).join('') }}\n    </ul>\n    \n    <h2 style=\"color: #333;\">Required Actions:</h2>\n    <div style=\"background-color: white; padding: 20px; border-radius: 5px;\">\n      {{ $('Generate Contractor Feedback').item.json.message }}\n    </div>\n    \n    <div style=\"text-align: center; margin-top: 30px;\">\n      <p style=\"color: #666;\">Please address these issues immediately and resubmit photos for verification.</p>\n    </div>\n  </div>\n</div>",
        "options": {
          "replyTo": "quality@yourcarwash.com"
        }
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1240,
        -340
      ],
      "id": "49d026d6-25f1-418d-a559-535bc44693a7",
      "name": "Email Contractor - Failed",
      "webhookId": "057efde5-541f-4bae-a08e-1c26f5700466"
    },
