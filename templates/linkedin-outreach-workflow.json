{
  "workflow_name": "LinkedIn Outreach AI Pipeline",
  "description": "Enterprise-grade LinkedIn outreach using multiple AI frameworks for maximum effectiveness",
  "version": "1.0",
  "category": "sales_automation",
  "tags": ["linkedin", "outreach", "sales", "ai", "personalization"],
  "estimated_time": "2-3 minutes per prospect",
  "success_metrics": {
    "target_response_rate": "35-45%",
    "personalization_score": ">85%",
    "compliance_rating": "Enterprise-grade"
  },
  "workflow": {
    "nodes": [
      {
        "id": "input_node",
        "type": "input",
        "name": "Prospect Input",
        "description": "Input prospect information",
        "position": {"x": 100, "y": 100},
        "config": {
          "inputs": {
            "linkedin_url": {
              "type": "string",
              "required": true,
              "placeholder": "https://linkedin.com/in/prospect-name",
              "validation": "linkedin_url"
            },
            "company_name": {
              "type": "string", 
              "required": false,
              "placeholder": "Optional: Override company detection"
            },
            "campaign_context": {
              "type": "string",
              "required": true,
              "placeholder": "What are you selling/offering?",
              "example": "AI automation platform for enterprise workflows"
            },
            "sender_info": {
              "type": "object",
              "required": true,
              "properties": {
                "name": "string",
                "company": "string", 
                "title": "string",
                "value_proposition": "string"
              }
            }
          }
        },
        "outputs": ["prospect_data"]
      },
      {
        "id": "research_agent",
        "type": "agent", 
        "name": "AI Research Team",
        "description": "Multi-agent research using CrewAI",
        "position": {"x": 300, "y": 100},
        "framework": "crewai",
        "config": {
          "useEnhancedMode": true,
          "enhancedFramework": "crewai",
          "enhancedProvider": "openai",
          "enhancedModel": "gpt-4",
          "systemMessage": "You are an expert LinkedIn research team specialized in prospect intelligence gathering.",
          "agentType": "researcher",
          "tools": ["web_search", "linkedin_scraper", "company_research"],
          "agents": [
            {
              "role": "LinkedIn Profile Analyst",
              "goal": "Extract comprehensive insights from LinkedIn profiles including background, interests, recent activity, and connection patterns",
              "backstory": "Expert at reading between the lines of LinkedIn profiles to find personalization opportunities",
              "tools": ["linkedin_scraper", "profile_analyzer"],
              "max_execution_time": 120
            },
            {
              "role": "Company Intelligence Researcher", 
              "goal": "Research company context, recent news, industry trends, and business challenges",
              "backstory": "Specialist in company research and market analysis for sales intelligence",
              "tools": ["web_search", "company_database", "news_search"],
              "max_execution_time": 120
            },
            {
              "role": "Connection Opportunity Finder",
              "goal": "Identify mutual connections, shared experiences, common interests, and conversation starters",
              "backstory": "Expert at finding authentic connection points between people",
              "tools": ["connection_analyzer", "interest_matcher"],
              "max_execution_time": 90
            }
          ],
          "max_iterations": 3,
          "memory": true
        },
        "inputs": ["prospect_data"],
        "outputs": ["research_insights"]
      },
      {
        "id": "personalization_engine",
        "type": "tool",
        "name": "Personalization Intelligence",
        "description": "Advanced personalization using LangChain + Claude",
        "position": {"x": 500, "y": 100},
        "framework": "langchain",
        "config": {
          "useEnhancedMode": true,
          "enhancedFramework": "langchain", 
          "enhancedProvider": "anthropic",
          "enhancedModel": "claude-3-sonnet",
          "chainType": "sequential",
          "temperature": 0.7,
          "maxTokens": 1500,
          "prompts": [
            {
              "name": "insight_analysis",
              "template": "Analyze the research insights and identify the top 3 personalization opportunities:\n\nResearch Data: {research_insights}\nCampaign Context: {campaign_context}\n\nProvide:\n1. Primary personalization hook (most compelling)\n2. Secondary hook (backup option)\n3. Company-specific angle\n4. Conversation starter question\n5. Value proposition alignment"
            },
            {
              "name": "message_strategy",
              "template": "Based on the personalization analysis, create a message strategy:\n\nPersonalization Hooks: {personalization_hooks}\nProspect Profile: {prospect_data}\nSender Info: {sender_info}\n\nDefine:\n1. Message tone (professional/casual/friendly)\n2. Key talking points (2-3 max)\n3. Call-to-action strategy\n4. Follow-up approach\n5. Risk factors to avoid"
            }
          ],
          "memory": true,
          "tools": ["text_analyzer", "sentiment_analyzer"]
        },
        "inputs": ["research_insights", "prospect_data", "campaign_context", "sender_info"],
        "outputs": ["personalization_strategy"]
      },
      {
        "id": "message_generator",
        "type": "tool",
        "name": "AI Message Generator", 
        "description": "Generate personalized LinkedIn messages",
        "position": {"x": 700, "y": 100},
        "framework": "langchain",
        "config": {
          "useEnhancedMode": true,
          "enhancedFramework": "langchain",
          "enhancedProvider": "openai", 
          "enhancedModel": "gpt-4",
          "chainType": "structured_output",
          "temperature": 0.8,
          "maxTokens": 800,
          "outputSchema": {
            "connection_request": "string",
            "follow_up_message": "string", 
            "alternative_version": "string",
            "subject_line": "string",
            "personalization_score": "number",
            "tone_analysis": "string"
          },
          "systemPrompt": "You are an expert LinkedIn outreach specialist. Create authentic, personalized messages that feel human and build genuine connections. Avoid sales-y language and focus on value and mutual benefit.",
          "tools": ["message_optimizer", "tone_analyzer"]
        },
        "inputs": ["personalization_strategy", "prospect_data", "sender_info"],
        "outputs": ["generated_messages"]
      },
      {
        "id": "quality_checker",
        "type": "tool",
        "name": "Message Quality Control",
        "description": "AI-powered quality assurance using Perplexity",
        "position": {"x": 900, "y": 100},
        "framework": "universal_api",
        "config": {
          "useEnhancedMode": true,
          "enhancedFramework": "universal_api",
          "enhancedProvider": "perplexity",
          "enhancedModel": "sonar-pro",
          "api_service_name": "perplexity_quality_check",
          "temperature": 0.3,
          "systemMessage": "You are a LinkedIn compliance and quality expert. Analyze messages for effectiveness, compliance, and authenticity.",
          "qualityChecks": [
            {
              "name": "compliance_check",
              "description": "Verify LinkedIn ToS compliance",
              "criteria": ["no spam indicators", "authentic tone", "appropriate length"]
            },
            {
              "name": "personalization_audit", 
              "description": "Validate personalization quality",
              "criteria": ["specific references", "relevant context", "authentic connection"]
            },
            {
              "name": "effectiveness_score",
              "description": "Predict response probability",
              "criteria": ["clear value prop", "compelling hook", "appropriate CTA"]
            }
          ]
        },
        "inputs": ["generated_messages", "research_insights"],
        "outputs": ["quality_report", "approved_messages"]
      },
      {
        "id": "ab_testing_node",
        "type": "tool",
        "name": "A/B Testing Engine",
        "description": "Generate message variations for testing",
        "position": {"x": 1100, "y": 100},
        "framework": "huggingface",
        "config": {
          "useEnhancedMode": true,
          "enhancedFramework": "huggingface",
          "enhancedProvider": "hf-inference",
          "hfTask": "text-generation",
          "hfModel": "microsoft/DialoGPT-medium",
          "hfTaskInputs": {
            "max_new_tokens": 150,
            "temperature": 0.9,
            "do_sample": true,
            "num_return_sequences": 3
          },
          "variations": [
            {
              "type": "tone_variation",
              "options": ["professional", "friendly", "casual"]
            },
            {
              "type": "hook_variation", 
              "options": ["company_news", "mutual_connection", "shared_interest"]
            },
            {
              "type": "cta_variation",
              "options": ["meeting_request", "resource_share", "question_based"]
            }
          ]
        },
        "inputs": ["approved_messages", "personalization_strategy"],
        "outputs": ["message_variations"]
      },
      {
        "id": "scheduler_node",
        "type": "tool",
        "name": "Smart Scheduler",
        "description": "Intelligent timing and follow-up scheduling",
        "position": {"x": 1300, "y": 100},
        "framework": "api",
        "config": {
          "toolType": "api",
          "method": "POST",
          "headers": {
            "Authorization": "[BYOK:linkedin_automation]",
            "Content-Type": "application/json"
          },
          "scheduling_logic": {
            "optimal_send_times": ["9-11 AM", "1-3 PM", "Tuesday-Thursday"],
            "follow_up_sequence": [
              {"delay": "3 days", "type": "soft_follow_up"},
              {"delay": "1 week", "type": "value_add"},
              {"delay": "2 weeks", "type": "final_attempt"}
            ],
            "rate_limiting": {
              "daily_limit": 20,
              "hourly_limit": 5,
              "cooling_period": "24 hours"
            }
          }
        },
        "inputs": ["message_variations", "prospect_data"],
        "outputs": ["scheduled_outreach", "follow_up_plan"]
      },
      {
        "id": "analytics_node",
        "type": "tool",
        "name": "Performance Analytics",
        "description": "Track and optimize outreach performance",
        "position": {"x": 1500, "y": 100},
        "framework": "api",
        "config": {
          "toolType": "analytics",
          "metrics": [
            {
              "name": "response_rate",
              "calculation": "responses / messages_sent",
              "target": 0.35
            },
            {
              "name": "meeting_conversion",
              "calculation": "meetings_booked / responses",
              "target": 0.25
            },
            {
              "name": "framework_performance",
              "calculation": "response_rate by ai_framework",
              "optimize": true
            }
          ],
          "reporting": {
            "frequency": "daily",
            "stakeholders": ["sales_team", "marketing"],
            "dashboards": ["executive", "operator"]
          }
        },
        "inputs": ["scheduled_outreach", "follow_up_plan"],
        "outputs": ["performance_metrics", "optimization_insights"]
      }
    ],
    "connections": [
      {"from": "input_node", "to": "research_agent"},
      {"from": "research_agent", "to": "personalization_engine"},
      {"from": "personalization_engine", "to": "message_generator"},
      {"from": "message_generator", "to": "quality_checker"},
      {"from": "quality_checker", "to": "ab_testing_node"},
      {"from": "ab_testing_node", "to": "scheduler_node"},
      {"from": "scheduler_node", "to": "analytics_node"}
    ]
  },
  "byok_requirements": {
    "required_providers": [
      {
        "provider": "openai",
        "models": ["gpt-4", "gpt-3.5-turbo"],
        "purpose": "Research and high-quality message generation"
      },
      {
        "provider": "anthropic", 
        "models": ["claude-3-sonnet"],
        "purpose": "Personalization analysis and strategy"
      },
      {
        "provider": "perplexity",
        "models": ["sonar-pro"],
        "purpose": "Quality control and fact-checking"
      },
      {
        "provider": "huggingface",
        "models": ["microsoft/DialoGPT-medium"],
        "purpose": "Message variation generation"
      }
    ],
    "optional_providers": [
      {
        "provider": "linkedin_automation",
        "purpose": "Direct LinkedIn integration"
      },
      {
        "provider": "crm_integration", 
        "purpose": "CRM data sync and tracking"
      }
    ]
  },
  "compliance_features": {
    "linkedin_tos_compliance": true,
    "rate_limiting": true,
    "data_privacy": "BYOK ensures no data retention",
    "audit_trail": true,
    "gdpr_compliance": true
  },
  "customization_options": {
    "industry_templates": ["tech", "finance", "healthcare", "consulting"],
    "tone_presets": ["executive", "startup", "enterprise", "creative"],
    "campaign_types": ["sales", "partnership", "recruiting", "networking"],
    "personalization_depth": ["light", "medium", "deep", "ultra"]
  },
  "success_templates": {
    "tech_startup_to_enterprise": {
      "response_rate": "42%",
      "framework_combo": ["crewai", "langchain", "perplexity"],
      "key_insight": "Company research + mutual connections = highest conversion"
    },
    "consultant_to_cto": {
      "response_rate": "38%", 
      "framework_combo": ["langchain", "huggingface", "openai"],
      "key_insight": "Technical depth + industry trends = strong engagement"
    },
    "agency_to_marketing_director": {
      "response_rate": "35%",
      "framework_combo": ["crewai", "anthropic", "perplexity"],
      "key_insight": "Case studies + personalized insights = meeting requests"
    }
  },
  "roi_calculator": {
    "time_savings": "18 hours per week (vs manual outreach)",
    "response_rate_improvement": "2.5x industry average", 
    "cost_per_lead": "85% reduction vs traditional methods",
    "framework_efficiency": "Multiple AI models = higher quality output"
  }
} 